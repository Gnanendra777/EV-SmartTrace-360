# EV SmartTrace 360 - Environment Configuration Template
# Copy this file to .env and provide your secret credentials. Never commit .env to GitHub.

# Project & API Config
PROJECT_NAME="EV SmartTrace 360"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Database Connection
# Local Development defaults to SQLite:
DATABASE_URL=sqlite:///./ev_smarttrace.db
# Production Managed MySQL (AWS RDS / PlanetScale / Railway / Render):
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/<database_name>

# JWT Security & Auth
JWT_SECRET_KEY=your_super_secret_random_jwt_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI & Map Integrations (Optional)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPEN_CHARGE_MAP_API_KEY=your_open_charge_map_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend Environment Configuration (for frontend/.env)
# In production on Vercel, leave unset or set to relative /api when monorepo deployed:
# VITE_API_BASE_URL=https://your-api-domain.com/api
