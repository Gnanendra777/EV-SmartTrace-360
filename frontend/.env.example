# Frontend API URL configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws/telemetry

# Map Provider Configuration (auto | google | osm)
# - auto: Uses Google Maps when VITE_GOOGLE_MAPS_API_KEY is present, falls back to OSM if absent/invalid
# - google: Forces official Google Maps SDK (falls back gracefully to Leaflet on error)
# - osm: Forces free OpenStreetMap / Leaflet stack (no Google key needed)
VITE_MAPS_PROVIDER=auto

# Optional Google Maps JavaScript API Key
# Enables official Google Maps vector roadmap, satellite, hybrid, live traffic layer and Place details
VITE_GOOGLE_MAPS_API_KEY=
